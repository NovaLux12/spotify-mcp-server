# Copy to .env (or set these in your MCP host config) and fill in your values.
# The server reads these from its process environment; Node 22.9+ supports
# --env-file-if-exists so `npm run dev` picks up a local .env automatically.
# Full reference: docs/configuration.md

# --- Auth ---

# Required. Your app's Client ID from https://developer.spotify.com/dashboard
# (Settings > Basic Information). This server uses the PKCE OAuth flow, so no
# client secret is ever needed.
SPOTIFY_CLIENT_ID=your_client_id_here

# OAuth redirect URI. Must match the redirect URI configured in your Spotify
# app settings EXACTLY (no trailing slash). Leave unset to use the default
# below. The host must be loopback; the local callback listener binds the
# host/port of this URI (8888 by default).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Token cache location (written with mode 600). Default:
#   ~/.spotify-mcp/tokens.json
# Override when running multiple accounts or sandboxed homes.
#SPOTIFY_MCP_TOKEN_FILE=/home/you/.spotify-mcp/tokens.json

# Set to 1 to enable the headless paste-flow authentication for hosts without
# a browser (cloud VMs, containers, CI). The auth URL is printed instead of
# opening a browser; paste the resulting redirect URL back to finish.
#SPOTIFY_HEADLESS=1

# --- Runtime tuning ---

# Per-request HTTP timeout in milliseconds for every Spotify API call and
# token refresh (protects against hung connections). Default: 30000.
#SPOTIFY_REQUEST_TIMEOUT_MS=30000

# Default per-call item cap for list-type tools; individual calls can still
# pass a smaller/larger `max_results`. Default: 50.
#SPOTIFY_MCP_MAX_ITEMS=50

# Hard cap for fetch_all=true pagination walks (protects against runaway
# loops over huge libraries). Default: 500.
#SPOTIFY_MCP_FETCH_ALL_CAP=500

# --- Mutation history (opt-in) ---

# Set to 1 to append one JSON line per agent-driven mutation (playlists,
# library saves, follows) enabling undo/audit.
#SPOTIFY_MCP_HISTORY=1

# Directory for the mutation JSONL log. Default:
#   ~/.spotify-mcp/history   (file: mutations.jsonl)
#SPOTIFY_MCP_HISTORY_DIR=/home/you/.spotify-mcp/history
