# Copy to .env (or set these in your MCP host config) and fill in your values.
# The server reads these from its process environment; Node 22.9+ supports
# --env-file-if-exists so `npm run dev` picks up a local .env automatically.
# Full reference: docs/configuration.md

# --- Auth ---

# Required. Your app's Client ID from https://developer.spotify.com/dashboard
# (Settings > Basic Information). This server uses the PKCE OAuth flow, so no
# client secret is ever needed.
SPOTIFY_CLIENT_ID=your_client_id_here

# OAuth redirect URI. Must match the redirect URI configured in your Spotify
# app settings EXACTLY (no trailing slash). Leave unset to use the default
# below. The host must be loopback; the local callback listener binds the
# host/port of this URI (8888 by default).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Profile name. Selects a namespaced token file:
#   ~/.spotify-mcp/tokens.<profile>.json
# Use this (or `spotify-mcp auth --profile <name>`) to keep several accounts
# side by side. Lowered priority than SPOTIFY_MCP_TOKEN_FILE.
#SPOTIFY_MCP_PROFILE=

# Token cache location (written with mode 600). Default:
#   ~/.spotify-mcp/tokens.json
# Override when running multiple accounts or sandboxed homes.
#SPOTIFY_MCP_TOKEN_FILE=/home/you/.spotify-mcp/tokens.json

# OAuth scopes to request, space- or comma-separated. Unset requests the 17
# default scopes; an unknown scope fails startup, and so does a value that is
# set but names no scope. Narrowing this is the way to reduce what the consent
# prompt asks for — the defaults include every mutation scope.
#SPOTIFY_SCOPES=user-read-private user-library-read

# Set to 1 to enable the headless paste-flow authentication for hosts without
# a browser (cloud VMs, containers, CI). The auth URL is printed instead of
# opening a browser; paste the resulting redirect URL back to finish.
#SPOTIFY_HEADLESS=1

# --- Runtime tuning ---

# Per-request HTTP timeout in milliseconds for every Spotify API call and
# token refresh (protects against hung connections). Default: 30000.
#SPOTIFY_REQUEST_TIMEOUT_MS=30000

# Default per-call item cap for list-type tools; individual calls can still
# pass a smaller/larger `max_results`. Default: 50.
#SPOTIFY_MCP_MAX_ITEMS=50

# Hard cap for fetch_all=true pagination walks (protects against runaway
# loops over huge libraries). Default: 500.
#SPOTIFY_MCP_FETCH_ALL_CAP=500

# The one knob for how many Spotify API requests the request funnel keeps in
# flight at once. This is THE process-wide width: every request in the server
# passes through it, including those a single tool fans out. Starts are still
# paced a minimum 100ms apart and still stop entirely during a Retry-After
# cooldown, so this is a ceiling on simultaneous requests, not a licence to
# burst. 1 restores the strictly serial funnel. Values above 32 are clamped to
# 32, so unbounded concurrency cannot be configured by accident.
# Default: 3.
#SPOTIFY_MCP_MAX_CONCURRENCY=3

# --- Tool surface ---

# Hard read-only mode. Set to 1/true/yes/on (case-insensitive) to hide every
# write-capable module, so no agent can mutate the account through this server
# regardless of which scopes were granted. Read-only modules, resources and
# prompts stay available subject to their own gates. A value that names no
# boolean (e.g. "enabled") is read as OFF and warns on stderr — it will not
# fail closed for you.
#SPOTIFY_MCP_READONLY=1

# Register only some toolsets, comma-separated (playlists,player,library,...).
# Unset registers the curated default (`core` + resources + prompts); `all`
# registers everything. Use this to widen or narrow the tool list for hosts
# that cap it; it hides tools, it does not restrict what they may do.
#SPOTIFY_MCP_TOOLSETS=all

# Register the stats.fm families (49 tools). Off by default: they need a
# separate stats.fm username in STATSFM_USER_ID and are of no use without one.
# Equivalent to naming `taste,statsfm` in SPOTIFY_MCP_TOOLSETS.
#SPOTIFY_MCP_STATSFM=1

# Keep dispatching the `taste_*` tool names retired in v3.0 (e.g. `taste_profile`
# -> `statsfm_taste_profile`). Off by default. The retired names are not
# advertised in tools/list either way, so this compat window costs no schema
# bytes; it only rewrites dispatch, and only if the `taste` toolset is on.
#SPOTIFY_MCP_LEGACY_ALIASES=1

# Set to exactly `never` to skip the confirmation prompt on destructive bulk
# operations. This is an automation bypass: the server otherwise fails CLOSED
# when the client cannot ask. Only set it in automation you control.
#SPOTIFY_MCP_CONFIRM=never

# Default ISO 3166-1 alpha-2 market for market-gated lookups, e.g. GB.
# Precedence: the tool's `market` argument, then this, then the account
# country. Default: unset (no market applied).
#SPOTIFY_MCP_MARKET=GB

# Default stats.fm user id or customId for the user-scoped stats.fm tools, so
# you do not have to pass one on every call. A per-call `user_id` (the endpoint
# tools) or `statsfm_user` (the taste tools and composites) argument always
# wins; this is only the fallback. Unset (the default) leaves that argument
# required, exactly as it was before this variable existed. Public profiles
# only — no token is involved either way.
#STATSFM_USER_ID=martijn

# How many requests a freshness-radar fan-out keeps in flight at once (the
# per-show lookups in show_new_episodes, the per-artist lookups in
# check_artist_releases / artist_release_digest, the per-type walks in
# search_deep). Concurrency bound, not a rate limiter: the request count a
# scan makes is unchanged. 1 restores the old strictly-serial walk.
# A bulk scan uses this to stay a good citizen of the shared funnel; it is the
# only way to narrow ONE scan below the funnel width. Leave it unset to take
# the funnel's own number.
# Default: unset (the funnel's width, i.e. 3).
#SPOTIFY_MCP_FANOUT_CONCURRENCY=4


# --- Read cache (opt-in persistence) ---

# The in-memory read cache is always on and needs no configuration. Its
# invalidation is scoped: a write drops the reads of the resource it changed
# and leaves unrelated ones cached, so an unrelated command like
# `add_to_queue` no longer costs you the whole cache.
#
# Set to 1 to also persist immutable catalog reads to disk, so a host that
# restarts the server per session does not re-walk the same catalog. Only
# resource identities are persisted — tracks, albums, artists, shows,
# episodes, audiobooks, genres, and the public /users/{id} profile. Your own
# data (/me/*), playlists, and everything BELOW a public profile
# (/users/{id}/top/artists, and the stats.fm listening data under the same
# shape) are never written: a second process would serve them without ever
# having seen the mutation that changed them. Entries carry the expiry they
# had in memory and are re-checked on load. Default: off.
#SPOTIFY_MCP_CACHE_PERSIST=1

# Directory for the persisted read cache, plus the file name inside it. The
# name follows the same profile rule as the token file, so two profiles never
# share one cache:
#   ~/.spotify-mcp/cache.json            (no profile)
#   ~/.spotify-mcp/cache.<profile>.json  (SPOTIFY_MCP_PROFILE=work)
# SPOTIFY_MCP_DATA_DIR overrides the directory, like the other sidecars.
#SPOTIFY_MCP_DATA_DIR=/home/you/.spotify-mcp


# --- Mutation history (opt-in) ---

# Set to 1 to append one JSON line per agent-driven mutation (playlists,
# library saves, follows) enabling undo/audit.
#SPOTIFY_MCP_HISTORY=1

# Directory for the mutation JSONL log. Default:
#   ~/.spotify-mcp/history   (file: mutations.jsonl)
#SPOTIFY_MCP_HISTORY_DIR=/home/you/.spotify-mcp/history

# Size cap for mutations.jsonl before it rotates to mutations.jsonl.1 (one
# generation kept, so the ledger never exceeds 2x this). Default: 1048576.
#SPOTIFY_MCP_HISTORY_MAX_BYTES=1048576


# --- Taste feedback store (local only, never networked) ---

# File for verdicts recorded by statsfm_record_feedback. Defaults to
# taste-feedback.json inside SPOTIFY_MCP_DATA_DIR (~/.spotify-mcp). The full
# path is the override; tests set it to a temp directory so a run never
# touches the real store. Written atomically (temp + rename) at 0600.
#SPOTIFY_MCP_TASTE_FEEDBACK_FILE=/home/you/.spotify-mcp/taste-feedback.json

# Verdicts retained in the store. The oldest are evicted past this, and the
# count of dropped verdicts is reported rather than hidden. Default: 500.
#SPOTIFY_MCP_TASTE_FEEDBACK_MAX_ENTRIES=500

# Size cap for taste-feedback.json, in bytes. Evicts oldest-first until the
# file fits, so raising MAX_ENTRIES above this cannot unbound the store.
# Default: 1048576.
#SPOTIFY_MCP_TASTE_FEEDBACK_MAX_BYTES=1048576
