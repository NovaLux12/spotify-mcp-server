# Dependencies and generated build output
node_modules/
dist/
coverage/
*.js.map
*.tgz

# Local configuration and credentials
.env
.env.local
.npmrc

# Logs and test/tool caches
*.log
npm-debug.log*

# Operating system and editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Local sweep memory - keep only final reports
memory/*
!memory/live-sweep-report.json
!memory/live-sweep-report.md
!memory/live-sweep-plan.md

# sweep-loop.sh runtime state: the lock it holds and the report it stages
# before an atomic rename. A REPORT outside memory/ would otherwise dirty the
# tree on every batch.
.sweep-loop.lock/
.*.tmp.*

# Ephemeral / local audit artifacts
.tmp/
.surface-census.json
USABILITY_AUDIT_*.md
audit-quota-lurkers.md
